# Slack credentials — from api.slack.com/apps → your app → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_SIGNING_SECRET=your-signing-secret-here

# Anthropic API key — from console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# SQLite database path (absolute path recommended for systemd service)
DATABASE_PATH=/root/recon-agent/recon.db

# Port (default 3000 — nginx proxies from 443)
PORT=3000
